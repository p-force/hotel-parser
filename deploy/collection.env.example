# Copy to .env.collection, chmod 600; replace placeholders. Never commit real values.
POSTGRES_DB=hotel_parser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
# URL-encode the password; must match PostgreSQL initialization credentials.
HOTEL_PARSER_DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@postgres:5432/hotel_parser?sslmode=disable
YANDEX_DISK_TOKEN=replace-with-an-oauth-token
YANDEX_DISK_DIR=/hotel-parser
HOTEL_PARSER_LOG_FORMAT=json
HOTEL_PARSER_LOG_LEVEL=info
# Explicit opt-in: keep false until VPS acceptance and handover from Vercel.
HOTEL_PARSER_COLLECTION_ENABLED=false
HOTEL_PARSER_WORKERS=4
HOTEL_PARSER_PROPERTY_CONCURRENCY=2
HOTEL_PARSER_TRAVELLINE_CONCURRENCY=2
HOTEL_PARSER_TRAVELLINE_START_INTERVAL=1s
HOTEL_PARSER_BNOVO_CONCURRENCY=2
HOTEL_PARSER_BNOVO_START_INTERVAL=500ms
HOTEL_PARSER_MAX_JOBS=64
HOTEL_PARSER_EXECUTION_TIMEOUT=45s
HOTEL_PARSER_SHUTDOWN_GRACE_PERIOD=5s
