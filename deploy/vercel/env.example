# Значения секретов задаются пользователем в Vercel Dashboard, не в этом файле.
HOTEL_PARSER_DATABASE_URL=
HOTEL_PARSER_TRIGGER_SECRET=
CRON_SECRET=
YANDEX_DISK_TOKEN=
YANDEX_DISK_DIR=/hotel-parser
HOTEL_PARSER_LOG_FORMAT=json
HOTEL_PARSER_LOG_LEVEL=INFO
# До проверки отсутствия второго collector и ограниченного smoke оставлять false.
HOTEL_PARSER_COLLECTION_ENABLED=false
# Для ограниченного теста 1; штатное значение 8, допустимо 1..64.
HOTEL_PARSER_MAX_JOBS=8
