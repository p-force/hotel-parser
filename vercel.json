{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "go",
  "buildCommand": "go build -buildvcs=false -o server ./cmd/api",
  "regions": [
    "fra1"
  ],
  "schedules": {
    "morning-start": {
      "schedule": "0 8 * * *",
      "timezone": "Europe/Moscow",
      "path": "/api/start",
      "requestMethod": "GET"
    },
    "morning-resume": {
      "schedule": "*/15 8-11 * * *",
      "timezone": "Europe/Moscow",
      "path": "/api/resume",
      "requestMethod": "GET"
    }
  }
}
